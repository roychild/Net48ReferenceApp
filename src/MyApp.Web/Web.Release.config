<?xml version="1.0" encoding="utf-8"?>
<!-- For more information on using web.config transformation visit https://go.microsoft.com/fwlink/?LinkId=301874 -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Point the SAML settings at your production service provider and identity provider, e.g.:

    <appSettings>
      <add key="Saml2:SpEntityId" value="https://myapp.example.com/Saml2" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
      <add key="Saml2:ReturnUrl" value="https://myapp.example.com/" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
      <add key="Saml2:IdpEntityId" value="https://idp.example.com/metadata" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
      <add key="Saml2:IdpMetadataUrl" value="https://idp.example.com/metadata" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    </appSettings>
  -->
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
</configuration>
