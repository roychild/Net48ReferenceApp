@model MyApp.Web.Models.UserProfile

<h1>@ViewBag.Title</h1>

<dl class="profile">
    <dt>Name</dt>
    <dd>@Model.Name</dd>
    <dt>Name identifier</dt>
    <dd>@Model.NameIdentifier</dd>
    <dt>Issuer</dt>
    <dd>@Model.Issuer</dd>
</dl>

<h2>Claims</h2>
<table class="claims">
    <thead>
        <tr>
            <th>Type</th>
            <th>Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var claim in Model.Claims)
        {
            <tr>
                <td>@claim.Type</td>
                <td>@claim.Value</td>
            </tr>
        }
    </tbody>
</table>

<p>The same data is available as JSON from <a href="~/api/profile">/api/profile</a>.</p>
